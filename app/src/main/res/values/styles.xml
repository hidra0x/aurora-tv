<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aurora" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <style name="Theme.Aurora.Player" parent="Theme.Aurora">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.Aurora.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
    </style>
</resources>
